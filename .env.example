# === LINE Official Account ===
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# === MySQL (aaPanel 外部管理) ===
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=medqueue
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=medical_queue

# === Redis (Docker 內部) ===
REDIS_URL=redis://redis:6379/0

# === 應用設定 ===
APP_ENV=production
APP_DEBUG=false
SCRAPE_INTERVAL_SECONDS=60
NOTIFY_THRESHOLD=5

# === 功能開關 (Feature Flags) ===
ENABLE_MOCK_HOSPITAL=false
ENABLE_WANFANG_SCRAPER=false
ENABLE_AUTO_CREATE_TABLES=false

# === 管理後台 ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# === 安全性 ===
# JWT 簽名金鑰（未設定時自動產生隨機值，重啟後 token 會失效）
# 正式環境務必設定固定值：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# === 告警 ===
# 管理員的 LINE User ID（接收爬蟲失敗告警）
ADMIN_LINE_USER_ID=
